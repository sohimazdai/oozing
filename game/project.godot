; Engine configuration file.
; Проект первой играбельной сцены Oozing (рабочее имя).

config_version=5

[application]

config/name="Oozing — первая сцена"
config/description="Прогулка по Кроме: изометрия 45°, перенесённые фрагменты в цилиндрических объёмах."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/mode=2
window/vsync/vsync_mode=1

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.36, 0.33, 0.45, 1)
anti_aliasing/quality/msaa_3d=2

[shader_globals]

player_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
cam_fwd={
"type": "vec3",
"value": Vector3(-0.5, -0.7071, -0.5)
}
cutaway_radius={
"type": "float",
"value": 2.6
}
roof_cut_y={
"type": "float",
"value": 1000000.0
}
roof_cut_area={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
